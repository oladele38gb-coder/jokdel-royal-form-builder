    instruction: "Redesign Consultation Fee card with orange theme, large legible amount, and interactive copy account number button with feedback. Optimize mobile padding and typography."
    replacement_infos {
      original_chunk {
        target_content: "  // Group fields by sections if present\n  let currentSectionHeading = \'\';\n\n  return (\n    <div className=\"py-8 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto\">\n      {/* Back Button */}\n      <button\n        onClick={onBack}\n        className=\"inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-600 hover:text-[#131B2E] transition-colors mb-6 group\"\n      >\n        <ArrowLeft className=\"w-4 h-4 text-slate-400 group-hover:text-[#131B2E] transition-colors\" />\n        <span>Back to All Inquiry Forms</span>\n      </button>\n\n      {/* Form Card */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden\">\n        {/* Document Banner / Header Notice if present */}\n        {form.headerNotice && (\n          <div className=\"bg-[#131B2E] text-white p-4 px-6 text-center text-xs font-semibold tracking-wide flex flex-col sm:flex-row items-center justify-between gap-2 border-b border-slate-800\">\n            <span className=\"font-serif text-sm italic font-bold tracking-wider\">JOKDEL ROYAL NIG. LTD</span>\n            <span className=\"text-slate-300 text-[11px]\">{form.headerNotice}</span>\n          </div>\n        )}\n\n        <div className=\"p-6 sm:p-10\">\n          {/* Form Title Header */}\n          <div className=\"border-b border-slate-100 pb-6 mb-8\">\n            <div className=\"inline-block px-2.5 py-1 rounded-md bg-slate-100 text-[#6E1E1E] text-xs font-semibold tracking-wider uppercase mb-2\">\n              {form.category || \'Jokdel Royal Form\'}\n            </div>\n            <h1 className=\"font-serif text-2xl sm:text-3xl font-bold text-[#131B2E] tracking-tight\">\n              {form.title}\n            </h1>\n            {form.description && (\n              <p className=\"mt-2 text-sm text-slate-600 leading-relaxed\">\n                {form.description}\n              </p>\n            )}\n          </div>\n\n          {/* Consultation Fee / Commitment Notice Box if present */}\n          {form.noticeBox && (\n            <div className=\"mb-8 p-5 bg-amber-50/80 border border-amber-200 rounded-2xl space-y-3\">\n              <div className=\"flex items-center gap-2.5 text-[#6E1E1E]\">\n                <ShieldCheck className=\"w-5 h-5 text-[#C5A059] shrink-0\" />\n                <h3 className=\"text-sm font-bold uppercase tracking-wider\">{form.noticeBox.title}</h3>\n              </div>\n              <p className=\"text-xs text-slate-700 leading-relaxed\">\n                {form.noticeBox.description}\n              </p>\n\n              {form.noticeBox.bankDetails && (\n                <div className=\"mt-3 p-4 bg-white border border-amber-200 rounded-xl space-y-2\">\n                  <div className=\"flex items-center justify-between text-xs font-bold text-[#131B2E]\">\n                    <span className=\"flex items-center gap-1.5\">\n                      <Building className=\"w-4 h-4 text-[#6E1E1E]\" />\n                      <span>{form.noticeBox.bankDetails.bankName}</span>\n                    </span>\n                    <span className=\"px-2.5 py-1 bg-amber-100 text-[#6E1E1E] rounded-md font-mono text-xs\">\n                      Amount: {form.noticeBox.bankDetails.amount}\n                    </span>\n                  </div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs pt-1 border-t border-slate-100\">\n                    <div>\n                      <span className=\"text-slate-500\">Account Name: </span>\n                      <span className=\"font-bold text-[#131B2E]\">{form.noticeBox.bankDetails.accountName}</span>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-500\">Account Number: </span>\n                      <span className=\"font-mono font-bold text-[#131B2E] bg-slate-100 px-2 py-0.5 rounded\">\n                        {form.noticeBox.bankDetails.accountNumber}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Dynamic Fields Form */}"
        replacement_content: "  const handleCopyAccount = (accNum: string) => {\n    navigator.clipboard.writeText(accNum);\n    setCopiedAccount(true);\n    setTimeout(() => setCopiedAccount(false), 2000);\n  };\n\n  // Group fields by sections if present\n  let currentSectionHeading = \'\';\n\n  return (\n    <div className=\"py-4 sm:py-8 px-3 sm:px-6 lg:px-8 max-w-3xl mx-auto\">\n      {/* Back Button */}\n      <button\n        onClick={onBack}\n        className=\"inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-600 hover:text-[#131B2E] transition-colors mb-4 group\"\n      >\n        <ArrowLeft className=\"w-3.5 h-3.5 text-slate-400 group-hover:text-[#131B2E] transition-colors\" />\n        <span>Back to All Inquiry Forms</span>\n      </button>\n\n      {/* Form Card */}\n      <div className=\"bg-white rounded-xl sm:rounded-2xl border border-slate-200 shadow-xs overflow-hidden\">\n        {/* Document Banner / Header Notice if present */}\n        {form.headerNotice && (\n          <div className=\"bg-[#131B2E] text-white p-3 px-4 sm:px-6 text-center text-xs font-semibold tracking-wide flex flex-col sm:flex-row items-center justify-between gap-1 border-b border-slate-800\">\n            <span className=\"font-serif text-xs sm:text-sm italic font-bold tracking-wider\">JOKDEL ROYAL NIG. LTD</span>\n            <span className=\"text-slate-300 text-[10px] sm:text-[11px]\">{form.headerNotice}</span>\n          </div>\n        )}\n\n        <div className=\"p-4 sm:p-8\">\n          {/* Form Title Header */}\n          <div className=\"border-b border-slate-100 pb-4 mb-6\">\n            <div className=\"inline-block px-2.5 py-0.5 rounded-md bg-slate-100 text-[#6E1E1E] text-[10px] sm:text-xs font-semibold tracking-wider uppercase mb-1.5\">\n              {form.category || \'Jokdel Royal Form\'}\n            </div>\n            <h1 className=\"font-serif text-lg sm:text-2xl font-bold text-[#131B2E] tracking-tight\">\n              {form.title}\n            </h1>\n            {form.description && (\n              <p className=\"mt-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed\">\n                {form.description}\n              </p>\n            )}\n          </div>\n\n          {/* Consultation Fee / Commitment Notice Box (Light Blue / Orange Modern Redesign) */}\n          {form.noticeBox && (\n            <div className=\"mb-6 p-4 sm:p-5 bg-gradient-to-br from-orange-50/90 via-amber-50/80 to-sky-50/90 border border-orange-200/90 rounded-xl sm:rounded-2xl shadow-2xs space-y-3\">\n              <div className=\"flex items-center justify-between gap-2 border-b border-orange-200/60 pb-2.5\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"p-1.5 bg-orange-600 text-white rounded-lg shadow-2xs shrink-0\">\n                    <ShieldCheck className=\"w-4 h-4\" />\n                  </div>\n                  <h3 className=\"text-xs sm:text-sm font-extrabold uppercase tracking-wider text-orange-950\">\n                    {form.noticeBox.title}\n                  </h3>\n                </div>\n                <span className=\"text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-800 border border-orange-200\">\n                  Required Action\n                </span>\n              </div>\n\n              <p className=\"text-xs sm:text-sm text-slate-700 leading-relaxed font-normal\">\n                {form.noticeBox.description}\n              </p>\n\n              {form.noticeBox.bankDetails && (\n                <div className=\"mt-3 p-3.5 sm:p-4 bg-white/95 rounded-xl border border-orange-200 shadow-2xs space-y-3\">\n                  {/* Fee Amount Header */}\n                  <div className=\"flex flex-wrap items-center justify-between gap-2 p-2.5 rounded-lg bg-orange-50/90 border border-orange-200/80\">\n                    <span className=\"text-xs font-bold uppercase tracking-wider text-slate-600 flex items-center gap-1.5\">\n                      <CreditCard className=\"w-4 h-4 text-orange-600\" />\n                      Required Commitment Fee\n                    </span>\n                    <span className=\"text-xl sm:text-2xl font-black font-mono text-orange-600 tracking-tight\">\n                      {form.noticeBox.bankDetails.amount}\n                    </span>\n                  </div>\n\n                  {/* Bank & Account Details */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs\">\n                    <div className=\"p-2.5 bg-slate-50/80 rounded-lg border border-slate-100\">\n                      <span className=\"text-slate-400 font-semibold block text-[10px] uppercase tracking-wider mb-0.5\">\n                        Banker & Account Name\n                      </span>\n                      <p className=\"font-bold text-slate-900 text-xs sm:text-sm flex items-center gap-1.5\">\n                        <Building className=\"w-3.5 h-3.5 text-orange-600 shrink-0\" />\n                        <span>{form.noticeBox.bankDetails.bankName}</span>\n                      </p>\n                      <p className=\"text-slate-600 text-[11px] font-medium mt-0.5\">\n                        Name: <strong className=\"text-slate-800\">{form.noticeBox.bankDetails.accountName}</strong>\n                      </p>\n                    </div>\n\n                    <div className=\"p-2.5 bg-slate-50/80 rounded-lg border border-slate-100 flex flex-col justify-between\">\n                      <span className=\"text-slate-400 font-semibold block text-[10px] uppercase tracking-wider mb-0.5\">\n                        GTBank Account Number\n                      </span>\n                      <div className=\"flex items-center justify-between gap-2 mt-1 bg-white p-1.5 rounded-lg border border-orange-200/80 shadow-2xs\">\n                        <span className=\"font-mono text-sm sm:text-base font-black tracking-wider text-slate-900 pl-1\">\n                          {form.noticeBox.bankDetails.accountNumber}\n                        </span>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleCopyAccount(form.noticeBox!.bankDetails!.accountNumber)}\n                          className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-bold transition-all ${\n                            copiedAccount\n                              ? \'bg-emerald-600 text-white\'\n                              : \'bg-orange-600 hover:bg-orange-700 text-white shadow-2xs\'\n                          }`}\n                        >\n                          {copiedAccount ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5\" />\n                              <span>Copied!</span>\n                            </>\n                          ) : (\n                            <>\n                              <Copy className=\"w-3.5 h-3.5\" />\n                              <span>Copy</span>\n                            </>\n                          )}\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Dynamic Fields Form */}"
      }
      num_matches: 1
    }
  }
}
