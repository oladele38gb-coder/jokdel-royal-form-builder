    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  variant?: \'full\' | \'inline\' | \'compact\';\n  className?: string;\n  height?: number;\n}\n\nexport const Logo: React.FC<LogoProps> = ({ variant = \'inline\', className = \'\', height = 40 }) => {\n  if (variant === \'compact\') {\n    return (\n      <div className={`flex items-center gap-2 ${className}`}>\n        <svg\n          viewBox=\"0 0 120 70\"\n          className=\"h-9 w-auto text-[#131B2E]\"\n          fill=\"currentColor\"\n        >\n          {/* Roofs */}\n          <path\n            d=\"M 15 45 L 35 18 L 55 45 M 25 45 L 35 32 L 45 45\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"3.5\"\n            fill=\"none\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n          <path\n            d=\"M 35 45 L 60 10 L 85 45 M 48 45 L 60 28 L 72 45\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"4\"\n            fill=\"none\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n          <path\n            d=\"M 65 45 L 85 18 L 105 45 M 75 45 L 85 32 L 95 45\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"3.5\"\n            fill=\"none\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n          {/* Base line */}\n          <path d=\"M 5 46 Q 60 48 115 46\" stroke=\"#131B2E\" strokeWidth=\"2.5\" fill=\"none\" />\n          {/* Center Arch Window */}\n          <path d=\"M 54 44 A 6 6 0 0 1 66 44 L 66 46 L 54 46 Z\" fill=\"#131B2E\" />\n        </svg>\n        <div className=\"flex flex-col leading-tight\">\n          <span className=\"font-serif font-bold text-[#131B2E] text-lg tracking-wider\">JOKDEL</span>\n          <span className=\"font-serif text-[#C5A059] text-xs font-semibold tracking-widest -mt-1\">ROYAL</span>\n        </div>\n      </div>\n    );\n  }\n\n  if (variant === \'full\') {\n    return (\n      <div className={`flex flex-col items-center justify-center text-center select-none ${className}`}>\n        {/* SVG Graphic - Three Rooflines */}\n        <svg\n          viewBox=\"0 0 240 100\"\n          className=\"w-48 h-auto mb-1\"\n          fill=\"none\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          {/* Left Roof */}\n          <path\n            d=\"M 25 62 L 65 24 L 105 62\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"5\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n          {/* Left Roof Windows */}\n          <rect x=\"58\" y=\"44\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n          <rect x=\"65\" y=\"44\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n          <rect x=\"58\" y=\"51\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n          <rect x=\"65\" y=\"51\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n\n          {/* Right Roof */}\n          <path\n            d=\"M 135 62 L 175 24 L 215 62\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"5\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n          {/* Right Roof Windows */}\n          <rect x=\"168\" y=\"44\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n          <rect x=\"175\" y=\"44\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n          <rect x=\"168\" y=\"51\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n          <rect x=\"175\" y=\"51\" width=\"5\" height=\"5\" fill=\"#131B2E\" rx=\"0.5\" />\n\n          {/* Center Main High Roof */}\n          <path\n            d=\"M 55 62 L 120 12 L 185 62\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"6\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n          {/* Center Arched Window */}\n          <path\n            d=\"M 111 50 A 9 9 0 0 1 129 50 L 129 62 L 111 62 Z\"\n            fill=\"#131B2E\"\n          />\n          <line x1=\"120\" y1=\"41\" x2=\"120\" y2=\"62\" stroke=\"#FFFFFF\" strokeWidth=\"1.5\" />\n          <line x1=\"111\" y1=\"52\" x2=\"129\" y2=\"52\" stroke=\"#FFFFFF\" strokeWidth=\"1.5\" />\n\n          {/* Base Curved Line */}\n          <path\n            d=\"M 10 65 Q 120 70 230 65\"\n            stroke=\"#131B2E\"\n            strokeWidth=\"4\"\n            strokeLinecap=\"round\"\n          />\n        </svg>\n\n        {/* Text Wordmark */}\n        <div className=\"font-serif font-bold text-[#131B2E] text-2xl tracking-[0.2em] uppercase leading-none\">\n          JOKDEL\n        </div>\n\n        {/* ROYAL with Burgundy Droplets */}\n        <div className=\"flex items-center justify-center gap-2 mt-1\">\n          {/* Left Droplets */}\n          <svg viewBox=\"0 0 30 18\" className=\"w-6 h-4 text-[#6E1E1E] fill-current\">\n            <path d=\"M 25 15 C 28 8 20 2 12 6 C 18 10 20 16 25 15 Z\" />\n            <path d=\"M 12 16 C 15 10 8 5 2 8 C 7 11 9 16 12 16 Z\" />\n          </svg>\n\n          <span className=\"font-serif font-bold text-[#C5A059] text-lg tracking-[0.3em] uppercase\">\n            ROYAL\n          </span>\n\n          {/* Right Droplets */}\n          <svg viewBox=\"0 0 30 18\" className=\"w-6 h-4 text-[#6E1E1E] fill-current transform scale-x-[-1]\">\n            <path d=\"M 25 15 C 28 8 20 2 12 6 C 18 10 20 16 25 15 Z\" />\n            <path d=\"M 12 16 C 15 10 8 5 2 8 C 7 11 9 16 12 16 Z\" />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  // Inline header layout (default)\n  return (\n    <div className={`flex items-center gap-3 select-none ${className}`}>\n      <svg\n        viewBox=\"0 0 160 80\"\n        style={{ height: `${height}px` }}\n        className=\"w-auto text-[#131B2E]\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n      >\n        {/* Left Roof */}\n        <path\n          d=\"M 15 50 L 45 20 L 75 50\"\n          stroke=\"#131B2E\"\n          strokeWidth=\"4\"\n          strokeLinecap=\"round\"\n          strokeLinejoin=\"round\"\n        />\n        {/* Right Roof */}\n        <path\n          d=\"M 85 50 L 115 20 L 145 50\"\n          stroke=\"#131B2E\"\n          strokeWidth=\"4\"\n          strokeLinecap=\"round\"\n          strokeLinejoin=\"round\"\n        />\n        {/* Center High Roof */}\n        <path\n          d=\"M 38 50 L 80 10 L 122 50\"\n          stroke=\"#131B2E\"\n          strokeWidth=\"5\"\n          strokeLinecap=\"round\"\n          strokeLinejoin=\"round\"\n        />\n        {/* Center Arch */}\n        <path\n          d=\"M 73 40 A 7 7 0 0 1 87 40 L 87 50 L 73 50 Z\"\n          fill=\"#131B2E\"\n        />\n        {/* Base Line */}\n        <path\n          d=\"M 5 52 Q 80 55 155 52\"\n          stroke=\"#131B2E\"\n          strokeWidth=\"3\"\n          strokeLinecap=\"round\"\n        />\n      </svg>\n\n      <div className=\"flex flex-col\">\n        <span className=\"font-serif font-extrabold text-[#131B2E] text-xl tracking-[0.15em] leading-none uppercase\">\n          JOKDEL\n        </span>\n        <div className=\"flex items-center gap-1.5 mt-0.5\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-[#6E1E1E]\"></span>\n          <span className=\"font-serif font-bold text-[#C5A059] text-xs tracking-[0.25em] uppercase leading-none\">\n            ROYAL\n          </span>\n          <span className=\"w-1.5 h-1.5 rounded-full bg-[#6E1E1E]\"></span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
