    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { FormConfig } from \'../types\';\nimport { ArrowRight, Search, Building2, Key, ShieldCheck, Sparkles, Clock, CheckCircle2 } from \'lucide-react\';\n\ninterface PublicFormsListProps {\n  forms: FormConfig[];\n  onSelectForm: (formId: string) => void;\n}\n\nexport const PublicFormsList: React.FC<PublicFormsListProps> = ({ forms, onSelectForm }) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n\n  const activeForms = forms.filter((f) => f.isActive);\n\n  const categories = [\'All\', \'Sales\', \'Rentals\', \'Property Management\'];\n\n  const filteredForms = activeForms.filter((form) => {\n    const matchesCategory =\n      selectedCategory === \'All\' || form.category === selectedCategory;\n    const matchesSearch =\n      form.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      form.description.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchesCategory && matchesSearch;\n  });\n\n  const getCategoryIcon = (category?: string) => {\n    switch (category) {\n      case \'Sales\':\n        return <Building2 className=\"w-5 h-5 text-[#131B2E]\" />;\n      case \'Rentals\':\n        return <Key className=\"w-5 h-5 text-[#6E1E1E]\" />;\n      case \'Property Management\':\n        return <ShieldCheck className=\"w-5 h-5 text-[#C5A059]\" />;\n      default:\n        return <Sparkles className=\"w-5 h-5 text-[#131B2E]\" />;\n    }\n  };\n\n  return (\n    <div className=\"py-10 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto\">\n      {/* Intro Banner */}\n      <div className=\"text-center max-w-3xl mx-auto mb-10\">\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-[#6E1E1E] text-xs font-semibold tracking-wide uppercase mb-3\">\n          <span className=\"w-2 h-2 rounded-full bg-[#6E1E1E]\"></span>\n          Verified Real Estate Solutions\n        </div>\n        <h1 className=\"font-serif text-3xl sm:text-4xl font-bold text-[#131B2E] tracking-tight\">\n          Get in Touch with Jokdel Royal\n        </h1>\n        <p className=\"mt-3 text-base text-slate-600 leading-relaxed\">\n          Select an inquiry service below to submit your requirements directly to our property specialists. We guarantee prompt response within 24 business hours.\n        </p>\n      </div>\n\n      {/* Category Pills & Search Bar */}\n      <div className=\"flex flex-col md:flex-row items-center justify-between gap-4 mb-8 bg-slate-50 p-3 rounded-2xl border border-slate-200/80\">\n        {/* Category Filters */}\n        <div className=\"flex flex-wrap items-center gap-1.5 w-full md:w-auto\">\n          {categories.map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setSelectedCategory(cat)}\n              className={`px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap ${\n                selectedCategory === cat\n                  ? \'bg-[#131B2E] text-white shadow-xs\'\n                  : \'bg-white text-slate-600 hover:bg-slate-200/70 border border-slate-200\'\n              }`}\n            >\n              {cat === \'All\' ? \'All Services\' : cat}\n            </button>\n          ))}\n        </div>\n\n        {/* Search Input */}\n        <div className=\"relative w-full md:w-72\">\n          <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search forms...\"\n            className=\"w-full pl-10 pr-4 py-2 rounded-xl text-xs sm:text-sm bg-white border border-slate-200 focus:outline-hidden focus:border-[#131B2E] text-slate-800 placeholder-slate-400\"\n          />\n        </div>\n      </div>\n\n      {/* Forms Grid */}\n      {filteredForms.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {filteredForms.map((form) => (\n            <div\n              key={form.id}\n              className=\"group bg-white rounded-2xl border border-slate-200 p-6 shadow-xs hover:shadow-md hover:border-[#131B2E]/30 transition-all flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between gap-3 mb-3\">\n                  <div className=\"p-2.5 bg-slate-100 rounded-xl\">\n                    {getCategoryIcon(form.category)}\n                  </div>\n                  <span className=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700\">\n                    {form.category || \'General\'}\n                  </span>\n                </div>\n\n                <h3 className=\"font-serif text-xl font-bold text-[#131B2E] group-hover:text-[#6E1E1E] transition-colors\">\n                  {form.title}\n                </h3>\n                <p className=\"mt-2 text-sm text-slate-600 line-clamp-3 leading-relaxed\">\n                  {form.description}\n                </p>\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-slate-100 flex items-center justify-between\">\n                <div className=\"flex items-center gap-1.5 text-xs text-slate-500 font-medium\">\n                  <Clock className=\"w-3.5 h-3.5 text-slate-400\" />\n                  <span>~2 mins fill time</span>\n                </div>\n\n                <button\n                  onClick={() => onSelectForm(form.id)}\n                  className=\"inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#131B2E] text-white text-xs sm:text-sm font-semibold hover:bg-slate-800 transition-colors shadow-xs\"\n                >\n                  <span>Fill Form</span>\n                  <ArrowRight className=\"w-4 h-4 text-[#C5A059]\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"text-center py-16 bg-slate-50 rounded-2xl border border-slate-200 p-8\">\n          <p className=\"text-slate-500 font-medium text-base\">\n            No inquiry forms found matching your filter.\n          </p>\n          <button\n            onClick={() => {\n              setSelectedCategory(\'All\');\n              setSearchQuery(\'\');\n            }}\n            className=\"mt-3 text-xs font-semibold text-[#6E1E1E] hover:underline\"\n          >\n            Clear search filters\n          </button>\n        </div>\n      )}\n\n      {/* Trust Badges Footer */}\n      <div className=\"mt-14 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center text-slate-600\">\n        <div className=\"flex items-center justify-center gap-3\">\n          <CheckCircle2 className=\"w-5 h-5 text-[#6E1E1E]\" />\n          <span className=\"text-xs font-medium\">Verified Property Titles</span>\n        </div>\n        <div className=\"flex items-center justify-center gap-3\">\n          <CheckCircle2 className=\"w-5 h-5 text-[#131B2E]\" />\n          <span className=\"text-xs font-medium\">Fast Intermediary & Letting</span>\n        </div>\n        <div className=\"flex items-center justify-center gap-3\">\n          <CheckCircle2 className=\"w-5 h-5 text-[#C5A059]\" />\n          <span className=\"text-xs font-medium\">Structured Property Management</span>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { FormConfig } from \'../types\';\nimport { ArrowRight, Search, Building2, Key, ShieldCheck, Sparkles, Clock, CheckCircle2 } from \'lucide-react\';\n\ninterface PublicFormsListProps {\n  forms: FormConfig[];\n  onSelectForm: (formId: string) => void;\n}\n\nexport const PublicFormsList: React.FC<PublicFormsListProps> = ({ forms, onSelectForm }) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n\n  const activeForms = forms.filter((f) => f.isActive);\n\n  const categories = [\'All\', \'Sales\', \'Rentals\', \'Property Management\', \'KYC & Engagement\', \'Tenancy\'];\n\n  const filteredForms = activeForms.filter((form) => {\n    const matchesCategory =\n      selectedCategory === \'All\' || form.category === selectedCategory;\n    const matchesSearch =\n      form.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      form.description.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchesCategory && matchesSearch;\n  });\n\n  const getCategoryIcon = (category?: string) => {\n    switch (category) {\n      case \'Sales\':\n        return <Building2 className=\"w-4 h-4 text-[#131B2E]\" />;\n      case \'Rentals\':\n        return <Key className=\"w-4 h-4 text-[#6E1E1E]\" />;\n      case \'Property Management\':\n        return <ShieldCheck className=\"w-4 h-4 text-[#C5A059]\" />;\n      default:\n        return <Sparkles className=\"w-4 h-4 text-[#131B2E]\" />;\n    }\n  };\n\n  return (\n    <div className=\"py-4 sm:py-8 px-3 sm:px-6 lg:px-8 max-w-4xl mx-auto\">\n      {/* Intro Banner */}\n      <div className=\"text-center max-w-2xl mx-auto mb-6 sm:mb-8\">\n        <div className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 text-[#6E1E1E] text-[10px] sm:text-xs font-semibold tracking-wide uppercase mb-2\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-[#6E1E1E]\"></span>\n          Verified Real Estate Solutions\n        </div>\n        <h1 className=\"font-serif text-xl sm:text-3xl font-bold text-[#131B2E] tracking-tight\">\n          Get in Touch with Jokdel Royal\n        </h1>\n        <p className=\"mt-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed\">\n          Select an inquiry service below to submit your requirements directly to our property specialists.\n        </p>\n      </div>\n\n      {/* Category Pills & Search Bar */}\n      <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 mb-5 bg-slate-50 p-2 sm:p-3 rounded-xl sm:rounded-2xl border border-slate-200\">\n        {/* Category Filters */}\n        <div className=\"flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0 scrollbar-none w-full sm:w-auto\">\n          {categories.map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setSelectedCategory(cat)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all whitespace-nowrap ${\n                selectedCategory === cat\n                  ? \'bg-[#131B2E] text-white shadow-2xs\'\n                  : \'bg-white text-slate-600 hover:bg-slate-200/70 border border-slate-200\'\n              }`}\n            >\n              {cat === \'All\' ? \'All Services\' : cat}\n            </button>\n          ))}\n        </div>\n\n        {/* Search Input */}\n        <div className=\"relative w-full sm:w-60\">\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search forms...\"\n            className=\"w-full pl-8 pr-3 py-1.5 rounded-lg text-xs bg-white border border-slate-200 focus:outline-hidden focus:border-[#131B2E] text-slate-800 placeholder-slate-400\"\n          />\n        </div>\n      </div>\n\n      {/* Forms Grid - Clean, compact mobile cards */}\n      {filteredForms.length > 0 ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4\">\n          {filteredForms.map((form) => {\n            const estimatedMins = Math.max(2, Math.ceil((form.fields?.length || 4) * 0.5));\n\n            return (\n              <div\n                key={form.id}\n                onClick={() => onSelectForm(form.id)}\n                className=\"group bg-white rounded-xl border border-slate-200/90 p-3.5 sm:p-4 shadow-2xs hover:shadow-md hover:border-[#131B2E]/40 transition-all cursor-pointer flex flex-col justify-between gap-3\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between gap-2 mb-1.5\">\n                    <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-[#131B2E] tracking-wider uppercase\">\n                      {form.category || \'General\'}\n                    </span>\n                    <div className=\"flex items-center gap-1 text-[11px] text-slate-500 font-medium\">\n                      <Clock className=\"w-3 h-3 text-slate-400\" />\n                      <span>~{estimatedMins} mins fill time</span>\n                    </div>\n                  </div>\n\n                  <h3 className=\"font-serif text-sm sm:text-base font-bold text-[#131B2E] group-hover:text-[#6E1E1E] transition-colors leading-snug\">\n                    {form.title}\n                  </h3>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-slate-100 mt-1\">\n                  <span className=\"text-[11px] text-slate-400 font-medium\">\n                    {form.fields?.length || 0} Questions\n                  </span>\n\n                  <button\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      onSelectForm(form.id);\n                    }}\n                    className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#131B2E] text-white text-xs font-semibold hover:bg-slate-800 transition-colors shadow-2xs\"\n                  >\n                    <span>Fill Form</span>\n                    <ArrowRight className=\"w-3.5 h-3.5 text-[#C5A059]\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      ) : (\n        <div className=\"text-center py-10 bg-slate-50 rounded-xl border border-slate-200 p-6\">\n          <p className=\"text-slate-500 font-medium text-xs sm:text-sm\">\n            No inquiry forms found matching your filter.\n          </p>\n          <button\n            onClick={() => {\n              setSelectedCategory(\'All\');\n              setSearchQuery(\'\');\n            }}\n            className=\"mt-2 text-xs font-semibold text-[#6E1E1E] hover:underline\"\n          >\n            Clear search filters\n          </button>\n        </div>\n      )}\n\n      {/* Trust Badges Footer */}\n      <div className=\"mt-8 sm:mt-12 pt-5 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-3 text-center text-slate-600\">\n        <div className=\"flex items-center justify-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-[#6E1E1E]\" />\n          <span className=\"text-xs font-medium\">Verified Property Titles</span>\n        </div>\n        <div className=\"flex items-center justify-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-[#131B2E]\" />\n          <span className=\"text-xs font-medium\">Fast Intermediary & Letting</span>\n        </div>\n        <div className=\"flex items-center justify-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-[#C5A059]\" />\n          <span className=\"text-xs font-medium\">Structured Property Management</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
