bel: \'Lekki Phase 1 / Ikate / Chevron\', value: \'Lekki Phase 1\' },\n          { id: \'loc-4\', label: \'Ikeja / GRA / Magodo\', value: \'Ikeja GRA\' },\n          { id: \'loc-5\', label: \'Shagamu / Mowe Corridor (Ogun)\', value: \'Mowe-Shagamu\' },\n          { id: \'loc-6\', label: \'Ibadan Prime Layouts (Oyo)\', value: \'Ibadan\' },\n          { id: \'loc-7\', label: \'Abuja (Guzape / Maitama / Lugbe)\', value: \'Abuja\' },\n        ],\n      },\n      {\n        id: \'field-budget\',\n        type: \'select\',\n        label: \'Target Budget Range (NGN)\',\n        required: true,\n        options: [\n          { id: \'b-1\', label: \'\342\202\2465 Million - \342\202\24615 Million\', value: \'5M-15M\' },\n          { id: \'b-2\', label: \'\342\202\24615 Million - \342\202\24635 Million\', value: \'15M-35M\' },\n          { id: \'b-3\', label: \'\342\202\24635 Million - \342\202\24675 Million\', value: \'35M-75M\' },\n          { id: \'b-4\', label: \'\342\202\24675 Million - \342\202\246150 Million\', value: \'75M-150M\' },\n          { id: \'b-5\', label: \'Above \342\202\246150 Million\', value: \'150M+\' },\n        ],\n      },\n      {\n        id: \'field-land-use\',\n        type: \'radio\',\n        label: \'Intended Land Development Use\',\n        required: true,\n        options: [\n          { id: \'u-1\', label: \'Private Residential Home\', value: \'Residential\' },\n          { id: \'u-2\', label: \'Commercial / Multi-family Apartment Block\', value: \'Commercial\' },\n          { id: \'u-3\', label: \'Agricultural / Farming / Warehouse\', value: \'Agricultural\' },\n          { id: \'u-4\', label: \'Land Banking / Long-term Resale Investment\', value: \'Land Banking\' },\n        ],\n      },\n      {\n        id: \'field-timeline\',\n        type: \'select\',\n        label: \'Purchase Timeline\',\n        required: false,\n        options: [\n          { id: \'t-1\', label: \'Immediate (Within 14 Days)\', value: \'Immediate\' },\n          { id: \'t-2\', label: \'Within 1 - 3 Months\', value: \'1-3 Months\' },\n          { id: \'t-3\', label: \'3 - 6 Months\', value: \'3-6 Months\' },\n          { id: \'t-4\', label: \'Just Exploring Options\', value: \'Exploring\' },\n        ],\n      },\n      {\n        id: \'field-inspection-date\',\n        type: \'date\',\n        label: \'Preferred Site Inspection Date\',\n        required: false,\n        helpText: \'Select a weekend or weekday suitable for site visit with our agent.\',\n      },\n      {\n        id: \'field-comments\',\n        type: \'textarea\',\n        label: \'Additional Requirements or Title Preferences (C of O, Governor\\\'s Consent, Gazetted)\',\n        placeholder: \'Specify any title requirements, preferred acreage, or payment plan requests...\',\n        required: false,\n      },\n    ],\n  },\n  {\n    id: \'form-house-purchase\',\n    title: \'Luxury & Residential House Purchase\',\n    description: \'Find terraces, semi-detached duplexes, fully detached mansions, and apartments built to premium standards.\',\n    isActive: true,\n    category: \'Sales\',\n    createdAt: \'2026-07-05T11:00:00.000Z\',\n    updatedAt: \'2026-08-02T14:15:00.000Z\',\n    fields: [\n      {\n        id: \'field-buyer-name\',\n        type: \'text\',\n        label: \'Full Name\',\n        placeholder: \'e.g. Dr. Ngozi Okonkwo\',\n        required: true,\n      },\n      {\n        id: \'field-buyer-email\',\n        type: \'email\',\n        label: \'Email Address\',\n        placeholder: \'ngozi.o@company.ng\',\n        required: true,\n      },\n      {\n        id: \'field-buyer-phone\',\n        type: \'phone\',\n        label: \'Phone / WhatsApp Number\',\n        placeholder: \'0812 345 6789\',\n        required: true,\n      },\n      {\n        id: \'field-property-type\',\n        type: \'select\',\n        label: \'Property Type\',\n        required: true,\n        options: [\n          { id: \'pt-1\', label: \'2 or 3 Bedroom Luxury Apartment\', value: \'Apartment\' },\n          { id: \'pt-2\', label: \'4 Bedroom Terrace Duplex with BQ\', value: \'Terrace Duplex\' },\n          { id: \'pt-3\', label: \'4/5 Bedroom Semi-Detached House\', value: \'Semi-Detached\' },\n          { id: \'pt-4\', label: \'5/6 Bedroom Fully Detached Luxury Villa\', value: \'Fully Detached\' },\n          { id: \'pt-5\', label: \'Penthouse Apartment\', value: \'Penthouse\' },\n        ],\n      },\n      {\n        id: \'field-house-budget\',\n        type: \'select\',\n        label: \'Budget Range\',\n        required: true,\n        options: [\n          { id: \'hb-1\', label: \'\342\202\24645 Million - \342\202\24690 Million\', value: \'45M-90M\' },\n          { id: \'hb-2\', label: \'\342\202\24690 Million - \342\202\246180 Million\', value: \'90M-180M\' },\n          { id: \'hb-3\', label: \'\342\202\246180 Million - \342\202\246350 Million\', value: \'180M-350M\' },\n          { id: \'hb-4\', label: \'\342\202\246350 Million - \342\202\246700 Million\', value: \'350M-700M\' },\n          { id: \'hb-5\', label: \'Above \342\202\246700 Million\', value: \'700M+\' },\n        ],\n      },\n      {\n        id: \'field-payment-structure\',\n        type: \'radio\',\n        label: \'Preferred Payment Option\',\n        required: true,\n        options: [\n          { id: \'pay-1\', label: \'Outright Cash Purchase\', value: \'Outright\' },\n          { id: \'pay-2\', label: \'Milestone Installments (6-12 Months)\', value: \'Installments\' },\n          { id: \'pay-3\', label: \'Mortgage / Financial Institution Financing\', value: \'Mortgage\' },\n        ],\n      },\n      {\n        id: \'field-amenities\',\n        type: \'checkbox\',\n        label: \'Must-Have Features & Amenities\',\n        required: false,\n        options: [\n          { id: \'am-1\', label: \'Private Swimming Pool\', value: \'Swimming Pool\' },\n          { id: \'am-2\', label: \'Smart Home Automation\', value: \'Smart Home\' },\n          { id